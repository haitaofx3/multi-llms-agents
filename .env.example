# =============================================================================
# .env.example — 配置模板（本文件可提交；真实密钥请写进 .env，.env 已被 gitignore）
# =============================================================================
#
# 用法（二选一）：
#   1. 完全不建 .env —— 全部配置走 muti_llm_agent/config.py 的内置默认值，能直接启动；
#   2. cp .env.example .env，再把需要改的行取消注释并填值。
#
# 下面每一行都是「注释状态」，与当前内置默认值等价，所以原样复制不会改变任何行为。
# 键的含义、默认值与读取逻辑的唯一事实来源是 muti_llm_agent/config.py；
# 本文件与它保持同步，若发现不一致，改 config.py 之后请回来同步这一份。
#
# 布尔开关统一用 1 / 0（不是 true / false）。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. 模型供应商（OpenAI 兼容协议）
# -----------------------------------------------------------------------------
# 最少必填：LLM_MODEL_ID / LLM_API_KEY / LLM_BASE_URL。
# 想真正「多模型协同」，再填 QWEN_* / DEEPSEEK_* / MIMO_* 三组，
# 然后由 models_registry.py 的协同配方按供应商意图自动改派。
# 注意：BASE_URL 只写到 /v1，OpenAI SDK 会自己拼 /chat/completions。
# LLM_MODEL_ID=mimo-v2.5
# LLM_API_KEY=
# LLM_BASE_URL=https://api.xiaomimimo.com/v1
# LLM_TIMEOUT=300

# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL_ID=qwen3.7-plus

# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL_ID=deepseek-chat

# MIMO_API_KEY=
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_MODEL_ID=mimo-v2.5


# -----------------------------------------------------------------------------
# 2. 独立裁判（Judge Agent）
# -----------------------------------------------------------------------------
# 裁判只给辩手评分、不参与辩论。全部留空时回退用主 Agent 的模型配置。
# JUDGE_NAME=独立裁判
# JUDGE_PROVIDER=
# JUDGE_BASE_URL=
# JUDGE_API_KEY=
# JUDGE_MODEL_ID=
# 综合分 = 内容分 × 权重 + 模型质量分（TTFT/生成速率）× 权重，两者之和建议为 1
# JUDGE_CONTENT_WEIGHT=0.8
# JUDGE_PERFORMANCE_WEIGHT=0.2


# -----------------------------------------------------------------------------
# 3. 费用估算（人民币 ¥，按「每百万 token 单价」估算整场费用）
# -----------------------------------------------------------------------------
# 默认值参考 DeepSeek-chat 官方定价；换供应商时按实际价格改。
# COST_INPUT_PER_1M=2.0
# COST_OUTPUT_PER_1M=8.0


# -----------------------------------------------------------------------------
# 4. 联网搜索工具
# -----------------------------------------------------------------------------
# 未配置时 web_search 工具返回友好提示，不会报错。
# SERPAPI_API_KEY=


# -----------------------------------------------------------------------------
# 5. 向量库与嵌入模型
# -----------------------------------------------------------------------------
# Qdrant 探测失败会自动降级为内存向量库（进程重启即清空，见 GET /api/kb/stats 的 backend）；
# 嵌入模型缺失时再降级为确定性哈希向量（无语义检索）。两者都不需要外部服务也能跑。
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=hello_agents_vectors
# QDRANT_VECTOR_SIZE=384
# QDRANT_DISTANCE=cosine
# QDRANT_TIMEOUT=3
# EMBED_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2


# -----------------------------------------------------------------------------
# 6. 收敛检测（连续 N 轮高度相似即判定收敛，提前结束）
# -----------------------------------------------------------------------------
# 嵌入不可用时会改用字符级相似度，其数值分布不同，故单独设阈值。
# CONVERGENCE_SIMILARITY=0.85
# CONVERGENCE_ROUNDS=2
# CONVERGENCE_TEXT_SIMILARITY=0.6
# CONVERGENCE_PER_SPEAKER=1


# -----------------------------------------------------------------------------
# 7. LLM 调用、上下文压缩与对手发言引用
# -----------------------------------------------------------------------------
# LLM_STREAM_WORKERS 是流式线程池容量：每路流式调用占一个 worker，超出排队。
# CONTEXT_* 控制单 Agent 上下文字符上限与触发 LLM 摘要的阈值。
# OPPONENT_* 控制辩手引用对手发言的截断长度（第 3 轮起改用 LLM 摘要）。
# LLM_RETRY_ATTEMPTS=3
# STREAM_TIMEOUT=300
# LLM_STREAM_WORKERS=8
# TOOL_LOOP_MAX=5
# CONTEXT_MAX_CHARS=8000
# CONTEXT_COMPRESS_THRESHOLD=6000
# CONTEXT_COMPRESS_KEEP_RECENT=8
# OPPONENT_SNIPPET_MAX_CHARS=500
# OPPONENT_SUMMARY_MAX_CHARS=200
# OPPONENT_ARGUMENT_SNIPPET_MAX_CHARS=160
# MEMORY_SUMMARY_MAX_CHARS=200


# -----------------------------------------------------------------------------
# 8. 多层公平性治理（FairnessGovernor）
# -----------------------------------------------------------------------------
# 刻意不使用 token 做跨模型公平度量（不同供应商 tokenizer 不可比），
# 改为「字符数 + 相对比例」。详见 muti_llm_agent/fairness.py。
# FAIR_OUTPUT_RATIO=1.5
# FAIR_HARD_CHAR_CEILING=3000
# FAIR_FLOOR_CHAR_LIMIT=400
# FAIR_OPENING_CHAR_LIMIT=1200
# FAIR_REFERENCE_ROUNDS=2
# FAIR_THINK_RATIO_MAX=0.5
# FAIR_MAX_SEEN_DIFF=1
# FAIR_TEMPERATURE=0.7
# FAIR_TOP_P=1.0
# FAIR_JUDGE_TEMPERATURE=0.3
# FAIR_JUDGE_TOP_P=1.0


# -----------------------------------------------------------------------------
# 9. 会话、部署形态与讨论模式
# -----------------------------------------------------------------------------
# MAX_SESSIONS 是会话注册表上限，超出后按 LRU 淘汰空闲会话（running/paused 永不淘汰）。
# PERSONAL_MODE 目前只是定位标记，不改会话上限、不做隔离。
# DEFAULT_RECIPE 可填 collab-4 / collab-3 / panel-5 / debate-3 / dual-2。
# DISCUSSION_MODE 是服务端兜底模式，请求里的 mode 优先。
# MAX_ITERATIONS = 首发 1 轮 + 补充材料续轮次数上限。
# MAX_SESSIONS=8
# PERSONAL_MODE=1
# OWNER_NAME=本机用户
# WORKSPACE_NAME=多模型协同工作台
# DEFAULT_RECIPE=collab-4
# MAX_ITERATIONS=5
# DISCUSSION_MODE=debate
# REFLECTION_ENABLED=1
# REFLECTION_MAX_PASSES=2


# -----------------------------------------------------------------------------
# 10. 访问控制与出站地址安全
# -----------------------------------------------------------------------------
# AUTH_TOKEN 为空 = 不校验，此时必须只绑 127.0.0.1（start.py 的默认行为）。
# 一旦用 HOST=0.0.0.0 对外暴露，**必须**设置，否则任何人都能改写配置、发起消耗额度的运行。
# 注意设置后 /healthz /docs /openapi.json 也要带令牌（白名单只有 / /favicon.ico /console /static/*）。
# AUTH_TOKEN=

# 默认 0 = 拒绝把自定义 base_url 指向回环/内网/保留地址（防 SSRF）。
# 本地部署自建模型服务（Ollama / vLLM）时设为 1 放开。
# CUSTOM_BASE_URL_ALLOW_PRIVATE=0


# -----------------------------------------------------------------------------
# 11. 日志与运行事件
# -----------------------------------------------------------------------------
# 诊断日志三条出口：stdout（JSON 行）、data/logs/app-YYYYMMDD.jsonl、进程内环形缓冲。
# 运行事件日志写 data/runs/{trace_id}.jsonl，是复盘时间线的唯一事实来源。
# LOG_TO_FILE=1
# LOG_RING_SIZE=2000
# LOG_LEVEL=info
# RUNLOG_ENABLED=1
# RUNLOG_MAX_EVENTS=20000


# -----------------------------------------------------------------------------
# 12. 中途注入纠偏（steering）
# -----------------------------------------------------------------------------
# 设为 0 时 POST /api/steer 返回 403。
# STEERING_MAX_PENDING 是待生效队列上限，满后 add 返回 400。
# STEERING_ENABLED=1
# STEERING_MAX_PENDING=20
# STEERING_TEXT_MAX_CHARS=1000


# -----------------------------------------------------------------------------
# 13. 会话结束后补充材料续轮（followup）
# -----------------------------------------------------------------------------
# 设为 0 时 /api/followup 返回 403。
# FOLLOWUP_CARRYOVER_CHARS 是「承接包」总长度上限（按比例切分各段）。
# FOLLOWUP_ENABLED=1
# FOLLOWUP_MAX_MATERIAL_CHARS=12000
# FOLLOWUP_CARRYOVER_CHARS=4000


# -----------------------------------------------------------------------------
# 14. SSE 实时推送
# -----------------------------------------------------------------------------
# SSE_KEEPALIVE_SEC 是空闲心跳间隔，防中间层掐断长连接。
# SSE_REPLAY_MAX 是断线重连回放的历史事件条数上限。
# SSE_KEEPALIVE_SEC=15.0
# SSE_REPLAY_MAX=200


# -----------------------------------------------------------------------------
# 15. 对外集成：飞书
# -----------------------------------------------------------------------------
# 入站只校验 verification token，未实现签名（X-Lark-Signature）校验。
# FEISHU_AUTO_RUN 默认关，避免入站消息误触发一场消耗额度的运行。
# FEISHU_WEBHOOK_URL=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_PUSH_ON_DONE=0
# FEISHU_AUTO_RUN=0
# FEISHU_AUTO_RUN_MAX_ROUNDS=3


# -----------------------------------------------------------------------------
# 16. 对外集成：通用出站 webhook
# -----------------------------------------------------------------------------
# WEBHOOK_URLS 用逗号 / 分号 / 换行分隔，只接受 http(s):// 地址。
# WEBHOOK_URLS=
# WEBHOOK_ON_DONE=0
# WEBHOOK_TIMEOUT=8.0


# -----------------------------------------------------------------------------
# 17. 对外集成：DSH（DeepSeek Harness）
# -----------------------------------------------------------------------------
# DSH_SHARED_SECRET 与 AUTH_TOKEN 相互独立，生命周期通常更长。
# DSH_ENABLED=1
# DSH_SHARED_SECRET=
# DSH_BASE_URL=


# -----------------------------------------------------------------------------
# 18. 开发 / 调试接口（/api/dev/*、/console）
# -----------------------------------------------------------------------------
# 默认开启（个人级试点）；对外暴露服务时建议设 DEV_API_ENABLED=0。
# 注意 /api/dev/invoke 能在进程内调用任意接口，等同于把控制面完整暴露。
# DEV_API_ENABLED=1
# DEV_API_TIMEOUT_MS=60000
